<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Flint.Core\Flint.Core.csproj" />
    <ProjectReference Include="..\Flint.Bluetooth\Flint.Bluetooth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flint.App.Tests" />
  </ItemGroup>

  <!-- Setup's jadx helper, compiled from FlintDecompile.java beside it, so a Java runtime without a compiler runs it. -->
  <ItemGroup>
    <EmbeddedResource Include="Setup\FlintDecompile.class" LogicalName="FlintDecompile.class" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>

  <!-- Published for Windows (-r win-*), the app takes the Windows target, which has the WinRT Bluetooth link. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Flint</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

</Project>
